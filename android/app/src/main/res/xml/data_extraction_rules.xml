<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: respaldar solo favoritos y ajustes; la caché de precios se vuelve a descargar. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="combustible.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="combustible.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
